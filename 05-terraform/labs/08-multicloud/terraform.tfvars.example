# azure tfvars

azure_resource_group_name    = "tfmc-rg"
azure_location               = "canadacentral"
azure_vm_count               = 2
azure_vm_size                = "Standard_B2s"
azure_admin_username         = "devopsuser"
azure_admin_password         = "<set-via-TF_VAR_azure_admin_password>"
azure_storage_account_count  = 2
azure_storage_account_prefix = "tfmcstoragenf1"


# aws tfvars

aws_region        = "ap-southeast-2"
aws_vm_count      = 2
aws_instance_type = "t3.micro"
aws_ami_id        = "ami-06259b63260eddc13"
aws_bucket_count  = 2
aws_bucket_prefix = "tfmcstoragenf"